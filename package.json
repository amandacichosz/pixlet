{
  "name": "pixlet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --filter @pixlet/docs dev",
    "build:libs": "pnpm --filter \"./packages/*\" -r run build",
    "build:docs": "pnpm build:libs && pnpm --filter @pixlet/docs build",
    "preview:docs": "pnpm --filter @pixlet/docs preview",
    "test": "vitest run",
    "pack:button": "pnpm build:libs && pnpm --filter @pixlet/button exec npm pack --dry-run",
    "test:browser": "pnpm build:docs && playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.52.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
